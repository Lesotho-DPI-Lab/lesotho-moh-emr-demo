# Copy to .env (scripts/init-env.sh does this with random secrets). Never commit .env.
EMR_SECRET_KEY=
EMR_DB_PASSWORD=
EMR_SECURE_COOKIES=true
EMR_FACILITY="Queen 'Mamohato Memorial Hospital"
# X-Road: moh-ss consumer interface (HTTPS, client certificate), our client id, the service we call
EMR_XROAD_SS_URL=https://10.255.100.184:8443
EMR_XROAD_CLIENT=LS-DEMO/GOV/MOH/CHILD-EMR
EMR_XROAD_SERVICE=LS-DEMO/GOV/MOHA/CIVIL-REGISTRY/child-verification
EMR_XROAD_PURPOSE=CHILD_HEALTH_SERVICE
EMR_XROAD_TIMEOUT=20
# Seconds between automatic retries of pending verifications (0 = off)
EMR_RETRY_INTERVAL=300
# Initial accounts: username:ROLE:Full name, comma-separated (roles NURSE, ADMIN); one password each
EMR_USERS=nurse.mpho:NURSE:Nurse Mpho Lebona,nurse.thato:NURSE:Nurse Thato Sello,emr.admin:ADMIN:EMR Administrator
EMR_PASSWORD_NURSE_MPHO=
EMR_PASSWORD_NURSE_THATO=
EMR_PASSWORD_EMR_ADMIN=
